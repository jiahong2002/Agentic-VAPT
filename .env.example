# OpenAI Codex API Key
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI model — set to the Codex model your API key has access to
# e.g. codex-mini-latest, gpt-4o, gpt-4.1, etc.
OPENAI_MODEL=codex-mini-latest

# OWASP ZAP — start ZAP in daemon mode first:
#   Windows: zap.bat -daemon -port 8080 -config api.key=your_zap_key
#   macOS/Linux: zap.sh -daemon -port 8080 -config api.key=your_zap_key
ZAP_HOST=http://localhost:8080
ZAP_API_KEY=your_zap_api_key_here
